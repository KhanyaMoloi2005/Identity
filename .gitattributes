# Normalise line endings so Windows and other systems agree.
* text=auto eol=lf
# Windows batch scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
# Binary files: never touch.
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.otf binary
*.jar binary
# Signed files: the signature covers the exact bytes, so never convert them.
android/filter-core/src/test/resources/**/signed-sample/* -text
