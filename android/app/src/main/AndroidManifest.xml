<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's declaration to Android: its screens, services and permissions.
  Each permission is added only by the milestone that needs it, and recorded in
  docs/PROJECT_LOG.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- M2.3: forward allowed DNS queries to the upstream resolver (D-003). Nothing else goes online. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- M2.2: run the VPN as a foreground service with a visible notification (D-022). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!--
      M3.3c-1: read how long TikTok is on screen (Usage access, switched on by the user in system
      Settings) and show the "limit reached" page over it (Display over other apps, same). D-030.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- M3.4: bring protection back after a restart or an update, if the user had it on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 13+: asked for once, so the "protection is on" notification can be shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      allowBackup=false + dataExtractionRules: keep private data (future events,
      reflections, rules) out of Google cloud backup and device-to-device transfer.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Identity">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The VPN. Not exported, and BIND_VPN_SERVICE means only Android itself can bind to it;
          other apps cannot start or control it.
          tools:ignore: lint thinks systemExempted also needs an exact-alarm permission. Android also
          accepts the user's VPN approval instead, which lint can't see (D-022).
        -->
        <service
            android:name=".protection.IdentityVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- M3.4: only reacts to the system's restart and update broadcasts. -->
        <receiver
            android:name=".protection.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          M3.3c-2 (D-031): leaves YouTube Shorts and Instagram Reels. Exported because Android itself
          must bind to it; BIND_ACCESSIBILITY_SERVICE means only Android can. Off until the user
          switches it on in system Settings. Sees only YouTube and Instagram (see the config file).
        -->
        <service
            android:name=".protection.ShortsReelsService"
            android:exported="true"
            android:label="@string/shorts_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/shorts_reels_service" />
        </service>
    </application>

</manifest>
